# Copy to .env (local) and set the same names in your host's environment settings.
# Never commit real values.

# --- Database (PostgreSQL) -------------------------------------------------
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# --- Auth.js ---------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Public site URL, no trailing slash. Used for metadata, emails and payment redirects.
AUTH_URL="http://localhost:3000"
# Google sign-in (optional; Auth.js reads these automatically)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Comma-separated emails that get the ADMIN role on sign-in.
ADMIN_EMAILS="you@example.com"

# --- Cloudinary (product images) -------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Paystack (payments) ---------------------------------------------------
PAYSTACK_SECRET_KEY=""

# --- Email (Resend). If RESEND_API_KEY is empty, emails are logged instead of sent.
RESEND_API_KEY=""
EMAIL_FROM="Loki <orders@yourdomain.com>"

# --- Cron ------------------------------------------------------------------
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/*.
CRON_SECRET=""

# --- Pricing / display -----------------------------------------------------
NEXT_PUBLIC_USD_TO_GHS="15"
# NEXT_PUBLIC_CURRENCY=""

# --- Seeding (npm run db:seed) ---------------------------------------------
# Change the password before seeding any non-local database.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
